{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATIONS",
        "class_name": "ConversationState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "conversation-state-v1",
      "new_sqlite_classes": ["ConversationState"]
    }
  ],
  "workflows": [
    {
      "name": "nexus-agent",
      "binding": "NEXUS_AGENT",
      "class_name": "NexusAgentWorkflow",
      "default_retention": {
        "success_retention": "1 day",
        "error_retention": "3 days"
      }
    }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "904201001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "MEDIA_RATE_LIMITER",
      "namespace_id": "904201002",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_AI_RATE_LIMITER",
      "namespace_id": "904201003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
