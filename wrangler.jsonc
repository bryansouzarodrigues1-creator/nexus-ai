{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION_STATE",
        "class_name": "NexusConversationState"
      }
    ]
  },
  "exports": {
    "NexusConversationState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "workflows": [
    {
      "name": "nexus-reasoning",
      "binding": "NEXUS_REASONING",
      "class_name": "NexusReasoningWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "904201001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "MEDIA_RATE_LIMITER",
      "namespace_id": "904201002",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_AI_RATE_LIMITER",
      "namespace_id": "904201003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
